	a schema1:DefinedTerm .
_:c14n0 dcterms:title "final temperature" ;
	qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
	qudt:unit <https://qudt.org/vocab/unit/DEG_C> ;
	a qudt:Quantity ;
	prov:value "700.0"^^xsd:float .
_:c14n1 dcterms:title "heating rate" ;
	qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/TemperaturePerTime> ;
	qudt:unit <https://qudt.org/vocab/unit/K-PER-HR> ;
	a qudt:Quantity , voc4cat:0008116 ;
	prov:value "500.0"^^xsd:float .
_:c14n2 qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
	qudt:unit <https://qudt.org/vocab/unit/DEG_C> ;
	a qudt:Quantity ;
	prov:value "70.0"^^xsd:float .
_:c14n3 dcterms:title "atmosphere" ;
	a prov:Entity , voc4cat:0007809 ;
	prov:value "5 % H2/N2" .
_:c14n4 dcterms:title "dwelling time at the final temperature" ;
