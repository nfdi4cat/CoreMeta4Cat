coremeta4cat:DEV_JLCAT03_tube-furnace dcterms:title "tube furnace" ;
	a prov:Agent .
coremeta4cat:PREC_JLCAT03_support dcterms:title "Al2O3" ;
	a voc4cat:0007794 .
coremeta4cat:SYN_JLCAT03 dcterms:hasPart coremeta4cat:SYN_JLCAT03_reduction ;
	a PROCO:0000001 ;
	prov:used coremeta4cat:PREC_JLCAT03_support , coremeta4cat:SYN_JLCAT03_method ;
	coremeta4cat:catalyst_measured_properties "Phase seen in PXRD is Pt" ;
	coremeta4cat:nominal_composition "Pt/Al2O3 (5 wt.%)" .
coremeta4cat:SYN_JLCAT03_method dcterms:title "Impregnation" ;
	a voc4cat:0007028 ;
	voc4cat:0008119 "incipient_wetness" ;
	voc4cat:0008206 _:c14n6 ;
	voc4cat:0008207 _:c14n2 .
coremeta4cat:SYN_JLCAT03_reduction dcterms:relation _:c14n0 , _:c14n1 , _:c14n3 , _:c14n4 , _:c14n5 , _:c14n7 ;
	dcterms:title "reduction in 5 % H2/N2" ;
	a prov:Activity , voc4cat:0000098 ;
	prov:wasAssociatedWith coremeta4cat:DEV_JLCAT03_tube-furnace .
