            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ] ;
    sh:targetClass coremeta4cat:ExsolutionSynthesis .

coremeta4cat:Ferroelectrics a sh:NodeShape ;
    sh:closed true ;
