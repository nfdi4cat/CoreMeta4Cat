coremeta4cat:Microkinetics a sh:NodeShape ;
    sh:closed true ;
    sh:description """Microkinetic modelling — a mean-field kinetic approach that integrates
elementary reaction steps and their rate constants to predict catalytic
activity and selectivity under reaction conditions.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <dcatap_plus:id> ],
        [ sh:datatype <xsd:string> ;
            sh:description """Numerical solver used for the microkinetic rate equations (e.g. LSODA,
stiff ODE solver, steady-state Newton method).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:solver_type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Rate constants or Arrhenius parameters (pre-exponential factor and
activation energy) for each elementary step in the reaction network.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path NCIT:C94967 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:float> ;
            sh:description "Surface coverage of adsorbed species (fraction of surface sites occupied)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:surface_coverage ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:float> ;
            sh:description "Activation energy for each elementary step in the reaction mechanism." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:activation_energy ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path SIO:000008 ] ;
    sh:targetClass coremeta4cat:Microkinetics .

coremeta4cat:MolecularSynthesis a sh:NodeShape ;
    sh:closed true ;
    sh:description """Catalyst preparation by molecular (organometallic or coordination)
chemistry routes, including crystallisation and purification steps.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "Temperature applied during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path VOC4CAT:0008207 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Device used for filtration." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:filtration_device ],
        [ sh:datatype <xsd:string> ;
            sh:description "Solvent(s) used for crystallisation." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:crystallisation_solvents ],
        [ sh:datatype <xsd:float> ;
            sh:description "Duration of the crystallisation step." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path coremeta4cat:crystallisation_duration ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Atmosphere maintained during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path VOC4CAT:0008208 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "Device used for mixing (e.g. magnetic stirrer, vortex mixer)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:mixing_device ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of filter membrane or medium used." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:filter_type ],
        [ sh:datatype <xsd:float> ;
            sh:description "Temperature ramp rate applied during drying or activation." ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path coremeta4cat:temperature_ramp ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Number of repeated cycles in a process (e.g. ALD cycles, impregnation cycles)." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path VOC4CAT:0008123 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature maintained during mixing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0008127 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 20 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path rdf:type ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Gaseous environment or atmospheric conditions during a process." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 13 ;
            sh:path VOC4CAT:0007809 ],
        [ sh:datatype <xsd:string> ;
