            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:reference_structure ],
        [ sh:datatype <xsd:float> ;
            sh:description "Magnitude of the spontaneous electric polarization." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:spontaneous_polarization ] ;
    sh:targetClass coremeta4cat:Ferroelectrics .

coremeta4cat:FixedBedReactor a sh:NodeShape ;
    sh:closed true ;
    sh:description """Fixed bed reactor — a tubular reactor packed with a stationary catalyst bed.
The most common reactor type in heterogeneous catalysis testing.""" ;
    sh:ignoredProperties ( rdf:type ) ;
