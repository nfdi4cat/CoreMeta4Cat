coremeta4cat:GrainBoundaries a sh:NodeShape ;
    sh:closed true ;
    sh:description """Grain boundary structure and energetics from atomistic simulation.
Relevant for understanding polycrystalline catalyst behaviour,
sintering, and charge/defect segregation.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Data describing charge carrier or point defect segregation behaviour
at the grain boundary (e.g. segregation energy per defect type).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:charge_defect_segregation ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:string> ;
            sh:description """Dimensions of the simulation cell used to model the grain boundary
(e.g. "10x10x30 nm").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:simulation_cell_size ],
        [ sh:datatype <xsd:float> ;
            sh:description "Misorientation angle between adjacent grains at the boundary." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:misorientation_angle ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystallographic plane of the grain boundary, expressed using
Miller indices (e.g. "Sigma5 (310)[001]").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:grain_boundary_plane ],
        [ sh:datatype <xsd:float> ;
            sh:description "Excess energy per unit area of the grain boundary." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:grain_boundary_energy ],
        [ sh:datatype <xsd:string> ;
            sh:description """Description of the structural units (repeating atomic motifs) that
