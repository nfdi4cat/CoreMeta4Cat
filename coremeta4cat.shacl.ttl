            sh:order 2 ;
            sh:path <http://purl.allotrope.org/ontologies/result#AFR_0002226> ],
        [ sh:class qudt:Quantity ;
            sh:description "Acceleration voltage applied to the electron beam." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path coremeta4cat:acceleration_voltage ] ;
    sh:targetClass coremeta4cat:ElectronMicroscopyMixin .

coremeta4cat:ElectronicStructure a sh:NodeShape ;
    sh:closed true ;
    sh:description """Electronic band structure and density of states, characterising the
electronic properties of a catalyst relevant to activity descriptors
(d-band centre, band gap, Fermi energy).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """High-symmetry k-path through the Brillouin zone used to plot the
band structure (e.g. "Gamma-X-M-Gamma-R" for cubic, following SeeK-path convention).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:band_path ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:boolean> ;
            sh:description """Whether the electronic structure calculation is spin-polarized
(accounts for spin-up and spin-down electrons separately).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:spin_polarized ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:energy_cutoff ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Monkhorst-Pack k-point mesh used for Brillouin zone sampling
(e.g. "4x4x1" for a surface slab, "8x8x8" for a bulk cell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path coremeta4cat:k_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description """Electronic smearing scheme and width used in the SCF calculation
(e.g. Methfessel-Paxton order 1 with sigma=0.2 eV, Gaussian with sigma=0.05 eV).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:smearing_method ],
        [ sh:datatype <xsd:float> ;
            sh:description "Fermi energy (chemical potential of electrons) in the calculated system." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:fermi_energy ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path SIO:001100 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:convergence_criteria ] ;
    sh:targetClass coremeta4cat:ElectronicStructure .

coremeta4cat:EnergyRangeMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing energy scan range slots, shared by X-ray spectroscopy
techniques that scan over an energy range (XRayAbsorptionSpectroscopy, XPS).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description """Energy scan range (minimum -> maximum) as a QuantitativeRange.
Provide unit as a QUDT term (e.g. eV, keV).""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:hasEnergyRange ] ;
    sh:targetClass coremeta4cat:EnergyRangeMixin .

coremeta4cat:EquationsOfState a sh:NodeShape ;
    sh:closed true ;
    sh:description """Equation of state relating energy (or enthalpy) to volume, fitted to a
parametric model (e.g. Birch-Murnaghan). Used to extract equilibrium
volume, bulk modulus, and its pressure derivative.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:energy_cutoff ],
        [ sh:datatype <xsd:float> ;
            sh:description "Root-mean-square residuals of the energy-volume fit." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:fit_residuals ],
        [ sh:datatype <xsd:string> ;
            sh:description """Parametric model used to fit the energy-volume curve
(e.g. Birch-Murnaghan 3rd order, Vinet, Murnaghan).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:fit_method ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:float> ;
            sh:description "Bulk modulus (resistance to uniform compression)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:bulk_modulus ],
        [ sh:datatype <xsd:float> ;
            sh:description "Pressure derivative of the bulk modulus B' (dimensionless)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:pressure_derivative ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description """Monkhorst-Pack k-point mesh used for Brillouin zone sampling
(e.g. "4x4x1" for a surface slab, "8x8x8" for a bulk cell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path coremeta4cat:k_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path SIO:001100 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:convergence_criteria ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ] ;
    sh:targetClass coremeta4cat:EquationsOfState .

coremeta4cat:ExsolutionSynthesis a sh:NodeShape ;
    sh:closed true ;
    sh:description """Catalyst preparation by exsolution: metal nanoparticles are grown on
a perovskite oxide surface by reduction/oxidation cycling.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:type ],
        [ sh:class qudt:Quantity ;
            sh:description "Time held at the final calcination temperature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path VOC4CAT:0000060 ],
        [ sh:class qudt:Quantity ;
            sh:description "Gas flow rate maintained during calcination." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0000056 ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class qudt:Quantity ;
            sh:description """Temperature range of the calcination programme (initial -> final temperature),
provided as a QuantitativeRange. Unit: Degree Celsius.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:hasCalcinationTemperatureRange ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature ramp rate during the calcination step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0008116 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Number of repeated cycles in a process (e.g. ALD cycles, impregnation cycles)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path VOC4CAT:0008123 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:class VOC4CAT:0000055 ;
