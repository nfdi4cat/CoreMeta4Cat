coremeta4cat:MonteCarlo a sh:NodeShape ;
    sh:closed true ;
    sh:description """Monte Carlo simulation — a stochastic method that samples configuration
space using random moves accepted or rejected according to a statistical
criterion (e.g. Metropolis). Used for adsorption isotherms, phase diagrams,
and lattice-based kinetics.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """Criterion for accepting or rejecting MC moves (e.g. Metropolis,
Kawasaki, heat-bath algorithm).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:acceptance_criteria ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Number of MC steps used for equilibration before data collection begins." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:equilibration_steps ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Total number of Monte Carlo moves or trial configurations generated." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:number_of_steps ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Interval between successive MC snapshots used for property averaging." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:sampling_interval ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <dcatap_plus:id> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Interaction potential or Hamiltonian used to compute energies in MC moves." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:interaction_potential ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Lattice geometry and dimensions used in lattice-based MC (e.g.
"100x100 square lattice", "hexagonal 50x50").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:lattice_size_type ] ;
    sh:targetClass coremeta4cat:MonteCarlo .

coremeta4cat:PhononDispersion a sh:NodeShape ;
    sh:closed true ;
    sh:description """Phonon dispersion relations computed from interatomic force constants,
providing access to vibrational frequencies, thermodynamic quantities,
and dynamical stability (imaginary modes).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description "Smearing or broadening parameter applied to the phonon density of states." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:smearing_parameter ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path SIO:001100 ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Method used to compute the interatomic force constants (e.g. finite
differences / supercell method, DFPT/linear response).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:force_constant_method ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:boolean> ;
            sh:description """Whether imaginary (soft) phonon modes are present in the dispersion.
Imaginary modes indicate dynamical instability of the structure.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:imaginary_modes ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """k/q-point mesh for phonon Brillouin zone sampling (e.g. "8x8x8").
Distinct from the electronic k-point mesh.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:kq_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:value ] ;
    sh:targetClass coremeta4cat:PhononDispersion .

coremeta4cat:PhotoluminescenceMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing optical excitation/emission parameters shared by
photoluminescence techniques (PhotoluminescenceSpectroscopy,
PhotoluminescenceLifetime).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "Excitation wavelength used in photoluminescence measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path <http://purl.allotrope.org/ontologies/result#AFR_0002479> ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Optical filter used in the emission or excitation path." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:optical_filter ],
        [ sh:class qudt:Quantity ;
            sh:description "Emission wavelength detected in photoluminescence measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path NCIT:C204101 ] ;
    sh:targetClass coremeta4cat:PhotoluminescenceMixin .

coremeta4cat:Piezoelectricity a sh:NodeShape ;
    sh:closed true ;
    sh:description """Piezoelectric response of a non-centrosymmetric material, described by the
piezoelectric tensor. Relevant for piezocatalysis applications.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """Decomposition of the piezoelectric or dielectric response into ionic
(nuclear) and electronic contributions.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:ionic_electronic_contributions ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "Point group or space group symmetry of the crystal structure." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:crystal_symmetry ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:float> ;
            sh:description "Magnitude of applied strain in the piezoelectric calculation." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:strain_applied ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:type ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Components of the piezoelectric tensor e_ij (C/m2) or d_ij (pC/N),
describing the coupling between stress and electric polarization.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:piezoelectric_tensor ] ;
    sh:targetClass coremeta4cat:Piezoelectricity .

coremeta4cat:PrecipitationMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing precipitation and wet-chemistry step parameters. Used by
preparation methods based on precipitation from solution
(CoPrecipitation, DepositionPrecipitation).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "Duration of the aging step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path VOC4CAT:0008204 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature maintained during mixing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0008127 ],
        [ sh:class qudt:Quantity ;
            sh:description "Rotational speed during mixing of synthesis components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Purification method applied after synthesis (e.g. washing, dialysis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path VOC4CAT:0008130 ],
        [ sh:class SIO:001089 ;
            sh:description "The slot to provide the PHValue of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the mixing step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0008126 ],
        [ sh:class CHMO:0002820 ;
            sh:description "Concentration of the precipitating agent/solution used to induce precipitation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path VOC4CAT:0008125 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Order in which reagents or components are combined." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path VOC4CAT:0008128 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Filtration method used to separate the precipitate (e.g. vacuum filtration)." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path VOC4CAT:0008129 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature maintained during the aging step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path VOC4CAT:0008131 ],
        [ sh:class CHEBI:23367 ;
            sh:description "Chemical agent used to induce precipitation (e.g. NaOH, NH3)." ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path VOC4CAT:0008203 ] ;
    sh:targetClass coremeta4cat:PrecipitationMixin .

coremeta4cat:SlurryReactor a sh:NodeShape ;
    sh:closed true ;
    sh:description """Slurry reactor — a three-phase reactor in which catalyst particles are
suspended in a liquid phase through which gas is bubbled.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description """The rotational speed of the agitator/impeller, typically expressed
in revolutions per unit time.""" ;
