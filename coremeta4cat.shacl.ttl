NCIT:C48936 a sh:NodeShape ;
    sh:closed true ;
    sh:description """A DataGeneratingActivity in which a catalyst, catalytic material, or
catalytic process is modelled computationally.

The simulation software is linked via carried_out_by as a Software agent.
The simulation method (protocol) is linked via realized_plan using a
SimulationMethod instance. The catalyst model or reaction being simulated
is linked via evaluated_entity or evaluated_activity.

The specific simulation type is expressed via rdf_type (e.g. coremeta4cat:DFT,
NCIT:C18097 for molecular dynamics), following DCAT-AP-PLUS Pattern 3.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description """The type of simulation method as an ontology term (e.g. coremeta4cat:DFT,
NCIT:C18097 for MD, coremeta4cat:Microkinetics). This is the primary
machine-actionable classification of the simulation type.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path rdf:type ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:generated ],
        [ sh:datatype <xsd:string> ;
            sh:description """Software package or code used for the simulation (e.g. VASP, Quantum ESPRESSO,
LAMMPS, CP2K, ORCA, Zacros). Include version number where possible.""" ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:software_package ],
        [ sh:class adms:Identifier ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path adms:identifier ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Location ;
            sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path prov:atLocation ],
        [ sh:class IAO:0000109 ;
            sh:description """A property computed by this Simulation, provided as a CalculatedProperty
instance. Multiple properties may be computed in a single simulation run.""" ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path coremeta4cat:calculated_property ],
        [ sh:class prov:Activity ;
            sh:description "The slot to specify the Activity about which the DataGeneratingActivity produced information." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasInformedBy ],
        [ sh:class prov:Agent ;
            sh:description "The simulation software used, provided as a Software agent instance." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Entity ;
            sh:description "The catalyst model, surface slab, or molecule being simulated." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:used ],
        [ sh:datatype <xsd:string> ;
            sh:description """Internal type designator for CatalysisDataGeneratingActivity subclasses
(Synthesis, Characterization, Simulation). Only needs to be set by hand
when nesting one of these inside another object's was_generated_by list
(e.g. in a combined CatalysisDataset file) -- LinkML fills it in
automatically when a class is instantiated directly.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path rdf:type ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:hasPart ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasInformedBy ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:used ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path dcterms:type ],
        [ sh:class OBI:0000272 ;
            sh:description "The SimulationMethod (protocol) realized in this Simulation." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:used ] ;
    sh:targetClass NCIT:C48936 .

