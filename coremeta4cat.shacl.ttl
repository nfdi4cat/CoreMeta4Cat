coremeta4cat:Sublimation a sh:NodeShape ;
    sh:closed true ;
    sh:description """Catalyst preparation by sublimation: a solid precursor is vaporised
and deposited onto a substrate without passing through a liquid phase.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class coremeta4cat:Atmosphere ;
