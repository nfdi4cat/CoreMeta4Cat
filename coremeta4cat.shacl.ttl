            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path SIO:000008 ],
        [ sh:class adms:Identifier ;
            sh:description "A slot to provide a secondary identifier for a Device." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
