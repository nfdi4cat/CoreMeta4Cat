@prefix CHMO: <http://purl.obolibrary.org/obo/CHMO_> .
@prefix ENM: <http://purl.enanomapper.org/onto/> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix NCIT: <http://purl.obolibrary.org/obo/NCIT_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix RXNO: <http://purl.obolibrary.org/obo/RXNO_> .
@prefix SIO: <http://semanticscience.org/resource/SIO_> .
@prefix VOC4CAT: <https://w3id.org/nfdi4cat/voc4cat_> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix coremeta4cat: <https://w3id.org/nfdi4cat/coremeta4cat/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<dcatap_plus:ClassifierMixin> a sh:NodeShape ;
    sh:closed false ;
    sh:description "A mixin with which an entity of this schema can be classified via an additional rdf:type or dcterms:type assertion." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path dcterms:type ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path rdf:type ] ;
    sh:targetClass <dcatap_plus:ClassifierMixin> .

<dcatap_plus:SupportiveEntity> a sh:NodeShape ;
    sh:closed true ;
    sh:description "The supportive entities are supporting the main entities in the Application Profile. They are included in the Application Profile because they form the range of properties." ;
    sh:ignoredProperties ( dcat:endDate <dcatap_plus:id> time:hasEnd skos:prefLabel skos:notation dcat:startDate time:hasBeginning dcterms:type rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ] ;
    sh:targetClass <dcatap_plus:SupportiveEntity> .

<http://purl.allotrope.org/ontologies/process#AFP_0000843> a sh:NodeShape ;
    sh:closed true ;
    sh:description "Size exclusion chromatography for molecular weight distribution determination." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path rdf:type ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "Volume injected in a chromatographic or mass spectrometric analysis." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:title ],
        [ sh:class qudt:Quantity ;
            sh:description "Volumetric flow rate of a gas or liquid." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:description ],
        [ sh:class CHEBI:23367 ;
            sh:description "Eluent or mobile phase used in chromatography." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Calibration standard used for molecular weight or retention time calibration." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:calibration_standard ],
        [ sh:datatype <xsd:string> ;
            sh:description "External standard used for quantification or calibration." ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:external_standard ],
        [ sh:datatype <xsd:string> ;
            sh:description "Internal standard used for quantification or calibration." ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:internal_standard ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of chromatographic column used." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:column_type ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path dcterms:type ] ;
    sh:targetClass <http://purl.allotrope.org/ontologies/process#AFP_0000843> .

ENM:0000064 a sh:NodeShape ;
    sh:closed true ;
    sh:description "Brunauer-Emmett-Teller analysis for specific surface area and pore size distribution." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature at which BET adsorption isotherm is measured (e.g. 77 K for N2)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path coremeta4cat:measurement_temperature ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description "Adsorbate gas used in BET surface area measurement (e.g. N2, Ar)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:adsorbate_gas ],
        [ sh:class qudt:Quantity ;
            sh:description "Mass of the sample used in a process or measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Method used for pore size distribution calculation (e.g. BJH, DFT, HK)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:pore_size_distribution_method ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature at which sample is degassed before BET measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path coremeta4cat:degassing_temperature ] ;
    sh:targetClass ENM:0000064 .

CHEBI:33250 a sh:NodeShape ;
    sh:closed true ;
    sh:description "An Entity constituting the smallest component of a chemical element having the chemical properties of the element." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Entity ;
            sh:description "A slot to provide a part of the Entity." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify an Entity of which the Entity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <dcatap_plus:id> ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a description for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:class adms:Identifier ;
            sh:description "A slot to provide a secondary identifier of the Entity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path adms:identifier ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a title for the Entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to provide the Atom as a ChEBI ID from the atom (CHEBI:33250) branch." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path dcterms:relation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ] ;
    sh:targetClass CHEBI:33250 .

