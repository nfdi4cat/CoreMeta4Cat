rl.allotrope.org/ontologies/result#AFR_0001595> coremeta4cat:flame_type VOC4CAT:0000050 coremeta4cat:vessel_volume coremeta4cat:wavelength_range VOC4CAT:0008153 coremeta4cat:lense_mode coremeta4cat:exchange_correlation_functional coremeta4cat:pore_size_distribution_method coremeta4cat:filter_or_grating VOC4CAT:0008204 coremeta4cat:fuel_dispersant_ratio coremeta4cat:gradient_program OBI:0001138 coremeta4cat:scattering_angle coremeta4cat:inlet_system <http://purl.allotrope.org/ontologies/result#AFR_0000950> VOC4CAT:0007239 coremeta4cat:ensemble_type NCIT:C164644 VOC4CAT:0008123 VOC4CAT:0008129 coremeta4cat:number_of_scans coremeta4cat:matrix_effect_correction coremeta4cat:electrolyte_composition coremeta4cat:hasCalcinationTemperatureRange VOC4CAT:0008206 VOC4CAT:0007204 VOC4CAT:0007202 <http://purl.obolibrary.org/obo/APOLLO_SV_00000012> <http://purl.allotrope.org/ontologies/result#AFR_0002226> <http://purl.allotrope.org/ontologies/result#AFR_0002479> coremeta4cat:energy_cutoff coremeta4cat:interaction_potential VOC4CAT:0008207 coremeta4cat:sonication_duration coremeta4cat:emission_range VOC4CAT:0008122 VOC4CAT:0007246 ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path <dcatap_plus:id> ] ;
    sh:targetClass coremeta4cat:CatalysisPlan .

coremeta4cat:ChromatographyMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing chromatographic separation parameters shared by
separation techniques (GCMS, SizeExclusionChromatography, HPLC_MS).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Type of chromatographic column used." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:column_type ],
        [ sh:class CHEBI:23367 ;
            sh:description "Eluent or mobile phase used in chromatography." ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path <http://purl.allotrope.org/ontologies/role#AFRL_0000011> ],
        [ sh:class qudt:Quantity ;
            sh:description "Volumetric flow rate of a gas or liquid." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Internal standard used for quantification or calibration." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:internal_standard ],
        [ sh:class qudt:Quantity ;
            sh:description "Volume injected in a chromatographic or mass spectrometric analysis." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "External standard used for quantification or calibration." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:external_standard ] ;
    sh:targetClass coremeta4cat:ChromatographyMixin .

coremeta4cat:DFT a sh:NodeShape ;
    sh:closed true ;
    sh:description """Density functional theory — a quantum mechanical method for calculating
the electronic structure of atoms, molecules, and periodic solids.
The most widely used ab initio method in computational catalysis.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """Hubbard U correction parameters (DFT+U). Specify element, orbital, and
U value (e.g. "Fe d: U=4.0 eV, J=0.0 eV").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:dft_u_parameters ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:energy_cutoff ],
        [ sh:datatype <xsd:float> ;
            sh:description "Total DFT ground-state energy divided by number of atoms in the unit cell." ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:total_energy_per_atom ],
        [ sh:datatype <xsd:string> ;
            sh:description """Exchange-correlation functional used (e.g. PBE, PBEsol, RPBE, B3LYP,
HSE06). The choice of functional directly affects accuracy.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:exchange_correlation_functional ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:convergence_criteria ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path <dcatap_plus:id> ],
        [ sh:datatype <xsd:boolean> ;
            sh:description """Whether spin polarization (collinear magnetism) is included in the DFT
calculation. Set to true for systems containing magnetic elements.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:spin_polarization ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ] ;
    sh:targetClass coremeta4cat:DFT .

coremeta4cat:DFTSettingsMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing plane-wave DFT numerical settings shared by CalculatedProperty
subclasses that are computed with periodic DFT (DielectricTensors,
EquationsOfState, ElectronicStructure, BandGap).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """Monkhorst-Pack k-point mesh used for Brillouin zone sampling
(e.g. "4x4x1" for a surface slab, "8x8x8" for a bulk cell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:k_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:convergence_criteria ],
        [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:energy_cutoff ] ;
    sh:targetClass coremeta4cat:DFTSettingsMixin .

coremeta4cat:DepositionPrecipitation a sh:NodeShape ;
    sh:closed true ;
    sh:description """Catalyst preparation by deposition-precipitation: the active phase
is precipitated directly onto the support surface.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class VOC4CAT:0000055 ;
            sh:description "Gaseous environment maintained during the calcination step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path SIO:000008 ],
        [ sh:class SIO:001089 ;
            sh:description "The slot to provide the PHValue of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature ramp rate during the calcination step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 21 ;
            sh:path VOC4CAT:0008116 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:title ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the aging step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path VOC4CAT:0008204 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature during the deposition step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:deposition_temperature ],
        [ sh:datatype <xsd:string> ;
            sh:description "Order in which reagents or components are combined." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path VOC4CAT:0008128 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the deposition step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path coremeta4cat:deposition_time ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the mixing step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path VOC4CAT:0008126 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature applied during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path VOC4CAT:0008207 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path rdf:type ],
        [ sh:class CHEBI:23367 ;
            sh:description "Chemical agent used to induce precipitation (e.g. NaOH, NH3)." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path VOC4CAT:0008203 ],
        [ sh:class CHMO:0002820 ;
            sh:description "Concentration of the precipitating agent/solution used to induce precipitation." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path VOC4CAT:0008125 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature maintained during mixing." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path VOC4CAT:0008127 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Filtration method used to separate the precipitate (e.g. vacuum filtration)." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path VOC4CAT:0008129 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature maintained during the aging step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path VOC4CAT:0008131 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Device used for drying (e.g. oven, rotary evaporator)." ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path VOC4CAT:0008122 ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Atmosphere maintained during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 16 ;
            sh:path VOC4CAT:0008208 ],
        [ sh:class qudt:Quantity ;
            sh:description "Gas flow rate maintained during calcination." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 22 ;
            sh:path VOC4CAT:0000056 ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the drying step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path VOC4CAT:0008206 ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Number of repeated cycles in a process (e.g. ALD cycles, impregnation cycles)." ;
            sh:nodeKind sh:Literal ;
            sh:order 19 ;
            sh:path VOC4CAT:0008123 ],
        [ sh:class qudt:Quantity ;
            sh:description "Rotational speed during mixing of synthesis components." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Purification method applied after synthesis (e.g. washing, dialysis)." ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path VOC4CAT:0008130 ],
        [ sh:class qudt:Quantity ;
            sh:description """Temperature range of the calcination programme (initial -> final temperature),
provided as a QuantitativeRange. Unit: Degree Celsius.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path coremeta4cat:hasCalcinationTemperatureRange ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path <dcatap_plus:id> ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:description ],
        [ sh:class qudt:Quantity ;
            sh:description "Time held at the final calcination temperature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path VOC4CAT:0000060 ] ;
    sh:targetClass coremeta4cat:DepositionPrecipitation .

coremeta4cat:DielectricTensors a sh:NodeShape ;
    sh:closed true ;
    sh:description """Dielectric tensor computed from density functional perturbation theory (DFPT).
Characterises the optical and static dielectric response of a material.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description """Components of the static and/or high-frequency dielectric tensor epsilon_ij,
computed from DFPT.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:dielectric_tensor ],
        [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:energy_cutoff ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path SIO:001100 ],
        [ sh:datatype <xsd:string> ;
            sh:description """Born effective charge tensors Z*_ij for each atom, describing how
the polarization changes with atomic displacements.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:born_effective_charges ],
        [ sh:datatype <xsd:string> ;
            sh:description """Monkhorst-Pack k-point mesh used for Brillouin zone sampling
(e.g. "4x4x1" for a surface slab, "8x8x8" for a bulk cell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:k_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:convergence_criteria ] ;
    sh:targetClass coremeta4cat:DielectricTensors .

coremeta4cat:DryingMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing drying step parameters. Used by preparation methods that
include a drying step after synthesis or precipitation
(Impregnation, CoPrecipitation, DepositionPrecipitation,
SonochemicalSynthesis, MolecularSynthesis).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "Device used for drying (e.g. oven, rotary evaporator)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path VOC4CAT:0008122 ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the drying step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path VOC4CAT:0008206 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature applied during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path VOC4CAT:0008207 ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Atmosphere maintained during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path VOC4CAT:0008208 ] ;
    sh:targetClass coremeta4cat:DryingMixin .

coremeta4cat:ElasticConstants a sh:NodeShape ;
    sh:closed true ;
    sh:description """Elastic mechanical properties of a material derived from the elastic tensor,
including bulk modulus, shear modulus, and Young's modulus.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description "Bulk modulus (resistance to uniform compression)." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:bulk_modulus ],
        [ sh:datatype <xsd:float> ;
            sh:description "Shear modulus (resistance to shear deformation)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:shear_modulus ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:float> ;
            sh:description "Poisson's ratio (ratio of transverse to axial strain under uniaxial load)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:poisson_ratio ],
        [ sh:datatype <xsd:string> ;
            sh:description """Full Voigt-notation elastic tensor C_ij (GPa) describing the linear
elastic response of the material.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:elastic_tensor ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:float> ;
            sh:description "Young's modulus (stiffness under uniaxial tension or compression)." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:young_modulus ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ] ;
    sh:targetClass coremeta4cat:ElasticConstants .

coremeta4cat:ElectrochemistryMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing electrochemical cell parameters shared by
electrochemical characterization techniques (CyclicVoltammetry,
ConductivityMeasurement).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class CHMO:0002820 ;
            sh:description "Concentration of the electrolyte." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path coremeta4cat:electrolyte_concentration ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Chemical composition of the electrolyte solution." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:electrolyte_composition ],
        [ sh:datatype <xsd:string> ;
            sh:description "Reference electrode used in electrochemical cell (e.g. Ag/AgCl, RHE)." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path VOC4CAT:0007204 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Working electrode used in electrochemical cell." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path VOC4CAT:0007202 ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Gaseous environment or atmospheric conditions during a process." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0007809 ],
        [ sh:datatype <xsd:string> ;
            sh:description "Counter electrode used in electrochemical cell." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path VOC4CAT:0007203 ] ;
    sh:targetClass coremeta4cat:ElectrochemistryMixin .

coremeta4cat:ElectronMicroscopyMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing electron gun and image parameters shared by electron
microscopy techniques (TransmissionElectronMicroscopy,
ScanningElectronMicroscopy).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
