<https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> a sh:NodeShape ;
    sh:closed false ;
    sh:description "A LinkML mixin used to pass down properties common to all material entities that are described in a chemical context via being composed of chemical entities (e.g. atom, molecule, ion, ion pair, radical, complex, conformer etc., ) of the same type or of different types." ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Mass of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path SIO:000008 ],
        [ sh:class SIO:001089 ;
            sh:description "The slot to provide the PHValue of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Volume of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path SIO:000008 ],
        [ sh:description "The slot to specify the physical state of a MaterialEntity." ;
            sh:in ( <http://purl.obolibrary.org/obo/PATO_0001736> <http://purl.obolibrary.org/obo/PATO_0001735> <http://purl.obolibrary.org/obo/PATO_0001737> <http://purl.obolibrary.org/obo/PATO_0015012> ) ;
            sh:maxCount 1 ;
            sh:order 5 ;
            sh:path SIO:000008 ],
        [ sh:class SIO:001406 ;
            sh:description "The slot to provide the Density of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path SIO:000008 ],
        [ sh:class CHEBI:23367 ;
            sh:description "The slot to provide the chemical entities of which a ChemicalSubstance is composed of." ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path skos:altLabel ],
        [ sh:class CHMO:0002820 ;
            sh:description "The slot to provide the Concentration of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the AmountConcentration of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ] ;
    sh:targetClass <https://w3id.org/nfdi-de/dcat-ap-plus/chemistry/entity/ChemicalSubstanceMixin> .

