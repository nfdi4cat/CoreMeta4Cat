            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class CHMO:0002820 ;
            sh:description "The slot to provide the Concentration of a ChemicalSubstance." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:title ],
        [ sh:description "The slot to specify the physical state of a MaterialEntity." ;
            sh:in ( <http://purl.obolibrary.org/obo/PATO_0001736> <http://purl.obolibrary.org/obo/PATO_0001735> <http://purl.obolibrary.org/obo/PATO_0001737> <http://purl.obolibrary.org/obo/PATO_0015012> ) ;
            sh:maxCount 1 ;
            sh:order 16 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:description ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Mass of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 10 ;
            sh:path dcterms:relation ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path dcterms:relation ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path skos:altLabel ] ;
    sh:targetClass SIO:010417 .

time:Instant a sh:NodeShape ;
    sh:closed true ;
    sh:description "See [DCAT-AP specs:TimeInstant](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#TimeInstant)" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ] ;
    sh:targetClass time:Instant .

dcat:CatalogRecord a sh:NodeShape ;
    sh:closed true ;
    sh:description "See [DCAT-AP specs:CatalogueRecord](https://semiceu.github.io/DCAT-AP/releases/3.0.0/#CatalogueRecord)" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class dcat:CatalogRecord ;
            sh:description "The original metadata that was used in creating metadata for the Dataset, Data Service or Dataset Series." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path dcterms:source ],
        [ sh:class dcterms:LinguisticSystem ;
            sh:description "A language used in the textual metadata describing titles, descriptions, etc. of the Catalogued Resource." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path dcterms:language ],
        [ sh:datatype <xsd:date> ;
            sh:description "The date on which the description of the Resource was included in the Catalogue." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:issued ],
        [ sh:description "A link to the Dataset, Data service or Catalog described in the record." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class dcat:Catalog ] [ sh:class dcat:Dataset ] [ sh:class dcat:DatasetSeries ] [ sh:class dcat:DataService ] ) ;
            sh:order 6 ;
            sh:path foaf:primaryTopic ],
        [ sh:datatype <xsd:date> ;
            sh:description "The most recent date on which the Catalogue entry was changed or modified." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:modified ],
        [ sh:class skos:Concept ;
            sh:description "The status of the catalogue record in the context of editorial flow of the dataset and data service descriptions." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path adms:status ],
        [ sh:datatype <xsd:string> ;
            sh:description "A name given to the Catalogue Record." ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:string> ;
            sh:description "A free-text account of the record. This property can be repeated for parallel language versions of the description." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:description ],
        [ sh:class dcterms:Standard ;
            sh:description "An Application Profile that the Catalogued Resource&#39;s metadata conforms to." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path dcterms:conformsTo ] ;
    sh:targetClass dcat:CatalogRecord .

coremeta4cat:CatalyticReaction a sh:NodeShape ;
    sh:closed true ;
    sh:description """A ChemicalReaction (chemdcat-ap) specialization representing the
catalytic reaction being studied. Inherits the generic reaction slots
(starting materials, reactants, products, catalyst, solvent, reactor,
temperature, pressure, yield, reaction steps) from ChemicalReaction and
adds catalysis-specific operating-condition slots.

Reaction is NOT a DataGeneratingActivity — it is the catalytic process
being observed, not the process that generates the dataset. A CatalysisDataset
is linked to the Reaction it is about via is_about_activity.

For operando experiments (e.g. in-situ XRD during a reaction), the dataset
carries both:
  was_generated_by: Characterization  (the measurement producing data)
  is_about_activity: Reaction         (the catalytic process being monitored)

The reactor is linked via the inherited used_reactor slot (is_a:
carried_out_by), narrowed here to require a ChemicalReactor instance
rather than touching the generic carried_out_by relation directly.
Reactants are linked via the inherited used_reactant slot (range:
Reagent) -- CatalyticReaction does not declare its own reactant slot.
The type of catalytic reaction (e.g. ammonia synthesis, CO oxidation)
is expressed via rdf_type using a voc4cat or ChemO term.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "The slot to specify the Pressure at which a ChemicalReaction takes place." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 18 ;
            sh:path SIO:000008 ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify the AgenticEntity that played a certain part in carrying out the Activity, either via having a specific role, function or disposition that was realized in the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype <xsd:duration> ;
            sh:description "A slot to provide the duration of a ChemicalReaction." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path schema1:duration ;
            sh:pattern "-?P((([0-9]+Y([0-9]+M)?([0-9]+D)?|([0-9]+M)([0-9]+D)?|([0-9]+D))(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S)))?)|(T(([0-9]+H)([0-9]+M)?([0-9]+(\\.[0-9]+)?S)?|([0-9]+M)([0-9]+(\\.[0-9]+)?S)?|([0-9]+(\\.[0-9]+)?S))))" ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Gaseous environment or atmospheric conditions during a process." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0007809 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to specify the Temperature at which a ChemicalReaction takes place." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 17 ;
            sh:path SIO:000008 ],
        [ sh:class adms:Identifier ;
            sh:description "A slot to provide a secondary identifier of the EvaluatedActivity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 25 ;
            sh:path adms:identifier ],
        [ sh:class qudt:Quantity ;
            sh:description "Total duration of the experiment or measurement run." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path SIO:000008 ],
        [ sh:description """The physical form or presentation of the catalyst as loaded into the
reactor (e.g. thin film, bulk, powder, supported). A separate axis
from catalyst_type (the catalytic regime).""" ;
            sh:in ( VOC4CAT:0000019 VOC4CAT:0007015 VOC4CAT:0000017 VOC4CAT:0000038 VOC4CAT:0007034 "other" ) ;
            sh:order 2 ;
            sh:path coremeta4cat:catalyst_form ],
        [ sh:class qudt:Quantity ;
            sh:description "Total pressure in the reactor during the experiment." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path VOC4CAT:0000118 ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was used as an input of an Activity that is to be changed, consumed or transformed." ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:used ],
        [ sh:class NCIT:C48810 ;
            sh:description "The slot to specify the Product(s) of a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path RO:0004008 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description """Temperature range in the reactor during the reaction, provided as a
QuantitativeRange with min_value and max_value (unit_code: "Cel").
For a single set-point, set min_value equal to max_value.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0007032 ],
        [ sh:class qudt:Quantity ;
            sh:description """Feed composition range studied, provided as a QuantitativeRange.
Express concentration bounds in an appropriate unit (e.g. "mol/L", "%" for
vol% or mol%). For fixed-composition experiments use reactant.has_concentration.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path coremeta4cat:feed_composition_range ],
        [ sh:class SIO:010417 ;
            sh:description "The slot to specify the chemical substance that had a solvent role (CHEBI:35223) in a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 32 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a description for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description """A name for the catalytic reaction which assigns the reactants and
(desired) products (e.g. "ammonia synthesis", "Fischer-Tropsch synthesis").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path VOC4CAT:0007009 ],
        [ sh:class SIO:010344 ;
            sh:description "The slot to specify the Catalyst of a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path RXNO:0000425 ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:generated ],
        [ sh:class VOC4CAT:0007018 ;
            sh:description """The reactor in which the Reaction takes place.
Must be a ChemicalReactor instance (a Reactor subclass specific to
catalytic reaction vessels, e.g. FixedBedReactor, CSTR, Autoclave).""" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class qudt:Quantity ;
            sh:description "Mass of catalyst loaded into the reactor." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:catalyst_quantity ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path <dcatap_plus:id> ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path dcterms:hasPart ],
        [ sh:class OBI:0000272 ;
            sh:description """The analytical method used to identify and/or quantify reaction products.
Should reference a CharacterizationTechnique instance (e.g. GCMS, HPLC_MS).
The abstract stub ProductIdentificationMethod is retained for backward compatibility.""" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path coremeta4cat:product_identification_method ],
        [ sh:class SIO:010411 ;
            sh:description "The slot to specify the Reagent(s) of a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path RO:0004009 ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:class schema1:DefinedTerm ;
            sh:description """The type of catalytic reaction as an ontology term (e.g. VOC4CAT:0007010
for a specific reaction type, or a ChemO/RXNO term).

This is the sole reaction-type classification mechanism (DCAT-AP-PLUS
Pattern 3) -- deliberately not duplicated by a dedicated has_reaction_type
slot + ReactionType class hierarchy (cf. PR #118, since superseded here).
Kept `recommended` rather than `required` for the same reason as
catalyst_type below: see nfdi4cat/CoreMeta4Cat#117 for the cardinality
discussion and nfdi4cat/CoreMeta4Cat#116 for the classification-mechanism
discussion.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 35 ;
            sh:path rdf:type ],
        [ sh:class <http://purl.obolibrary.org/obo/PROCO_0000029> ;
            sh:description "The slot to specify the StartingMaterial(s) of a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path RO:0004009 ],
        [ sh:description """The catalytic regime of the reaction (e.g. heterogeneous, homogeneous,
biocatalysis, electrocatalysis, photocatalysis). For the physical
form/presentation of the catalyst itself, use catalyst_form instead.

Deliberately kept `recommended` rather than `required` (see nfdi4cat/
CoreMeta4Cat#117): classification here can be genuinely disputed or
not yet covered by CatalysisResearchFieldEnum for a novel catalyst,
and forcing a value would push researchers into a premature or
contested classification rather than leaving the field unset until
consensus/vocabulary catches up. Open for discussion in a follow-up
issue if a different tradeoff is wanted. See also nfdi4cat/
CoreMeta4Cat#116 on whether this two-slot design (catalyst_type +
catalyst_form) or PR #118's CatalystType class hierarchy should be
the long-term mechanism -- kept as two enums here because the
VOC4CAT terms show CatalystType conflates the regime axis
(Heterogeneous/Homogeneous/Bio/Electro/Photo) with the physical-form
axis (ThinFilm/Bulk/Powdered/DepositedSample/Supported -- identical
VOC4CAT ids to catalyst_form's permissible values), which are
independent and often both apply to the same catalyst at once.""" ;
            sh:in ( VOC4CAT:0007001 VOC4CAT:0000294 VOC4CAT:0000204 VOC4CAT:0000216 VOC4CAT:0000001 "hybrid_catalysis" "other" ) ;
            sh:order 1 ;
            sh:path VOC4CAT:0007014 ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path dcterms:title ],
        [ sh:class coremeta4cat:CatalyticReaction ;
            sh:description """A step (part) of this CatalyticReaction that is itself a CatalyticReaction.
Narrowed from the inherited ChemicalReaction range so nested reaction
steps keep their catalysis-specific fields (catalyst_type, used_reactor,
product_identification_method, ...) when loaded.""" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path <http://purl.obolibrary.org/obo/BFO_0000051> ],
        [ sh:class CHMO:0002855 ;
            sh:description "A slot to provide the percentage of how much of the ChemicalProduct was produced by a ChemicalReaction." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 19 ;
            sh:path SIO:000008 ],
        [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 31 ;
            sh:path dcterms:relation ],
        [ sh:class rdfs:Resource ;
            sh:description "The slot to specify any Documents related to a ChemicalReaction." ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path dcterms:relation ] ;
    sh:targetClass coremeta4cat:CatalyticReaction .

VOC4CAT:0000122 a sh:NodeShape ;
    sh:closed true ;
    sh:description """A qualitative descriptor of the pre-treatment applied to a sample
before a process or measurement (e.g. "reduction at 300 °C", "outgassing").""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path prov:value ] ;
    sh:targetClass VOC4CAT:0000122 .

OBI:0000272 a sh:NodeShape ;
    sh:closed false,
        true ;
    sh:description """Abstract Plan describing the computational method (protocol) used in a
Simulation. Concrete subclasses carry method-specific parameter slots.
Linked from Simulation via realized_plan.""",
        """Abstract Plan representing the method used to identify and quantify reaction
products. In practice, users should reference a concrete CharacterizationTechnique
subclass from coremeta4cat_characterization_ap (e.g. GCMS, HPLC_MS, NMRSpectroscopy).

This abstract class is retained for backward compatibility with the original
CoreMeta4Cat monolith. It is a subclass of CatalysisPlan (which is itself a Plan,
prov:Plan / OBI:0000272) so that it can participate in the realized_plan slot,
and so it (and every other CoreMeta4Cat protocol/technique class) can carry a
persistent id.""",
        """An abstract Plan describing the analytical protocol used to characterize
a catalyst. Concrete subclasses specify technique-specific parameters.
Linked from Characterization via realized_plan.""" ;
    sh:ignoredProperties ( coremeta4cat:simulation_time coremeta4cat:activation_energy coremeta4cat:ensemble_type coremeta4cat:lattice_size_type coremeta4cat:dft_u_parameters NCIT:C94967 coremeta4cat:equilibration_steps <http://purl.obolibrary.org/obo/APOLLO_SV_00000012> coremeta4cat:sampling_interval coremeta4cat:energy_cutoff SIO:000008 coremeta4cat:spin_polarization coremeta4cat:convergence_criteria coremeta4cat:number_of_atoms coremeta4cat:interaction_potential coremeta4cat:force_field coremeta4cat:surface_coverage coremeta4cat:acceptance_criteria coremeta4cat:solver_type coremeta4cat:exchange_correlation_functional coremeta4cat:number_of_steps coremeta4cat:total_energy_per_atom rdf:type ),
        ( rdf:type ),
        ( coremeta4cat:oxidizing_gas_composition coremeta4cat:combustion_temperature coremeta4cat:element_analyzed coremeta4cat:beamline_source coremeta4cat:slit_width coremeta4cat:reducing_gas_composition coremeta4cat:carrier_gas_purity coremeta4cat:spot_size <AFQ:0000268> coremeta4cat:nmr_pulse_sequence VOC4CAT:0008116 VOC4CAT:0007218 coremeta4cat:sample_geometry coremeta4cat:image_resolution NCIT:C105701 coremeta4cat:external_standard <http://purl.allotrope.org/ontologies/result#AFR_0001594> coremeta4cat:background_correction_method coremeta4cat:adsorbate_gas coremeta4cat:optical_filter coremeta4cat:charge_compensation coremeta4cat:electrode_configuration coremeta4cat:counting_time coremeta4cat:split_ratio coremeta4cat:degassing_temperature coremeta4cat:field_emitter coremeta4cat:gun_type coremeta4cat:dispersant coremeta4cat:total_acquisition_time coremeta4cat:internal_standard coremeta4cat:absorption_edge coremeta4cat:measurement_temperature coremeta4cat:refractive_index VOC4CAT:0000176 coremeta4cat:measurement_duration coremeta4cat:number_of_shots rdf:type coremeta4cat:ac_dc_mode coremeta4cat:column_type coremeta4cat:primary_energy coremeta4cat:noise_of_measurement CHMO:0002792 CHMO:0002120 coremeta4cat:lifetime_fitting_model coremeta4cat:carrier_gas coremeta4cat:irradiation_frequency coremeta4cat:resolution coremeta4cat:hasEnergyRange coremeta4cat:inlet_temperature VOC4CAT:0007203 coremeta4cat:acquisition_mode coremeta4cat:calibration_method coremeta4cat:nucleus coremeta4cat:scan_potential_range coremeta4cat:calibration_standard coremeta4cat:hasWavenumberRange coremeta4cat:adsorption_gas coremeta4cat:electrolyte_concentration <http://purl.allotrope.org/ontologies/result#AFR_0001595> coremeta4cat:wavelength_range coremeta4cat:sample_spinning_speed coremeta4cat:lense_mode coremeta4cat:acceleration_voltage <http://purl.allotrope.org/ontologies/process#AFP_0003721> NCIT:C204101 coremeta4cat:pore_size_distribution_method coremeta4cat:filter_or_grating coremeta4cat:nmr_sample_tube coremeta4cat:solvent_delay coremeta4cat:gradient_program OBI:0001138 coremeta4cat:scattering_angle coremeta4cat:hasMzRange VOC4CAT:0007213 coremeta4cat:capillary_temperature coremeta4cat:hasTwoThetaRange <http://purl.allotrope.org/ontologies/result#AFR_0000950> coremeta4cat:diluting_reference VOC4CAT:0007239 NCIT:C164644 VOC4CAT:0008123 coremeta4cat:number_of_scans coremeta4cat:ratio_reference_sample VOC4CAT:0007809 coremeta4cat:matrix_effect_correction coremeta4cat:electrolyte_composition VOC4CAT:0007204 VOC4CAT:0007202 coremeta4cat:oven_temperature_range coremeta4cat:hasTemperatureRange <http://purl.allotrope.org/ontologies/result#AFR_0002226> <http://purl.allotrope.org/ontologies/role#AFRL_0000011> coremeta4cat:ionization_mode <http://purl.allotrope.org/ontologies/result#AFR_0002479> SIO:000008 coremeta4cat:trace_ion_detection coremeta4cat:elements_analyzed coremeta4cat:pass_energy coremeta4cat:emission_range VOC4CAT:0007246 ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
