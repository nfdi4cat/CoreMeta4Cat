coremeta4cat:AqueousStability a sh:NodeShape ;
    sh:closed true ;
    sh:description """Electrochemical (Pourbaix) stability of a catalyst in aqueous solution as
a function of pH and electrode potential. Critical for electrocatalyst
stability screening.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:float> ;
            sh:description "Ionic strength of the electrolyte solution modelled." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:ionic_strength ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path SIO:001100 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Temperature of a MaterialEntity or an Activity, whereas the temperature of the Activity is ontologically rooted in the temperature of the material entities that participate in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path SIO:000008 ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description """Implicit solvation model used to account for aqueous environment
(e.g. VASPsol, SCCS/Environ, COSMO).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:solvation_model ],
        [ sh:datatype <xsd:string> ;
            sh:description """Electrode potential range covered in the Pourbaix diagram
(e.g. "-2 to +2 V vs SHE").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:potential_range ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "pH range covered in the Pourbaix stability diagram (e.g. \"0-14\")." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:ph_range ] ;
    sh:targetClass coremeta4cat:AqueousStability .

coremeta4cat:BandGap a sh:NodeShape ;
    sh:closed true ;
    sh:description """Electronic band gap and its character (direct/indirect), with optional
many-body (GW) or excitonic corrections. Critical for photocatalyst
and semiconductor catalyst screening.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description "Plane-wave kinetic energy cutoff for the basis set expansion." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path coremeta4cat:energy_cutoff ],
        [ sh:datatype <xsd:string> ;
            sh:description """Reference to the material or MaterialSample being characterised by this
calculated band gap.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path VOC4CAT:0005056 ],
        [ sh:datatype <xsd:float> ;
            sh:description """Excitonic correction (from Bethe-Salpeter equation) applied to the
optical band gap.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path coremeta4cat:excitonic_correction ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path dcterms:description ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Model structure used in the band gap calculation (e.g. bulk unit cell,
surface slab, defect supercell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:structure_model ],
        [ sh:datatype <xsd:string> ;
            sh:description """Chemical composition of the simulated material (e.g. "Fe2O3", "Pt/CeO2").
Use empirical formula or SMILES for molecular systems.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path coremeta4cat:material_composition ],
        [ sh:datatype <xsd:boolean> ;
            sh:description """Whether a many-body GW correction or hybrid functional (e.g. HSE06)
was applied to correct the DFT band gap underestimation.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path coremeta4cat:gw_hybrid_correction ],
        [ sh:datatype <xsd:float> ;
            sh:description "Gaussian or Lorentzian broadening applied to the simulated spectrum." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:smearing_broadening ],
        [ sh:datatype <xsd:string> ;
            sh:description """Convergence thresholds applied during self-consistent field (SCF) and/or
geometry optimisation (e.g. energy < 1e-5 eV, forces < 0.02 eV/A).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path coremeta4cat:convergence_criteria ],
        [ sh:datatype <xsd:float> ;
            sh:description "Experimental band gap value used for benchmarking the calculation." ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:experimental_reference ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description """Crystal structure of the simulated material, including space group and
lattice parameters (e.g. "Fm-3m, a=3.92 A for Pt").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path SIO:001100 ],
        [ sh:datatype <xsd:string> ;
            sh:description """Band gap character: "direct" (VBM and CBM at same k-point) or
"indirect" (VBM and CBM at different k-points).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:direct_indirect ],
        [ sh:datatype <xsd:string> ;
            sh:description """Monkhorst-Pack k-point mesh used for Brillouin zone sampling
(e.g. "4x4x1" for a surface slab, "8x8x8" for a bulk cell).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path coremeta4cat:k_point_mesh ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:title ] ;
    sh:targetClass coremeta4cat:BandGap .

coremeta4cat:CalcinationMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing calcination step parameters. Used by preparation methods
that include a thermal calcination step
(Impregnation, CoPrecipitation, DepositionPrecipitation,
SonochemicalSynthesis, ExsolutionSynthesis).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description "Temperature ramp rate during the calcination step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0008116 ],
        [ sh:class qudt:Quantity ;
            sh:description """Temperature range of the calcination programme (initial -> final temperature),
provided as a QuantitativeRange. Unit: Degree Celsius.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:hasCalcinationTemperatureRange ],
        [ sh:class qudt:Quantity ;
            sh:description "Time held at the final calcination temperature." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 1 ;
            sh:path VOC4CAT:0000060 ],
        [ sh:datatype <xsd:integer> ;
            sh:description "Number of repeated cycles in a process (e.g. ALD cycles, impregnation cycles)." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path VOC4CAT:0008123 ],
        [ sh:class qudt:Quantity ;
            sh:description "Gas flow rate maintained during calcination." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0000056 ],
        [ sh:class VOC4CAT:0000055 ;
            sh:description "Gaseous environment maintained during the calcination step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ] ;
    sh:targetClass coremeta4cat:CalcinationMixin .

coremeta4cat:CatalysisPlan a sh:NodeShape ;
    sh:closed false ;
    sh:description """A CoreMeta4Cat specialization of DCAT-AP-PLUS's Plan that adds a
persistent identifier (id). Plan itself (external, dcat-ap-plus) only
lists title/description -- every CoreMeta4Cat protocol, technique, and
method class needs to be independently citable and cross-referenceable
(e.g. linked to from multiple Reaction/Characterization instances that
reuse the same protocol), so id is added once here rather than
repeated on each of PreparationMethod, CharacterizationTechnique,
SimulationMethod, and ProductIdentificationMethod individually.""" ;
    sh:ignoredProperties ( coremeta4cat:simulation_time coremeta4cat:combustion_temperature coremeta4cat:ball_material coremeta4cat:element_analyzed coremeta4cat:beamline_source coremeta4cat:slit_width coremeta4cat:fuel_to_oxidizer_ratio coremeta4cat:spot_size VOC4CAT:0008126 VOC4CAT:0008148 <AFQ:0000268> coremeta4cat:nmr_pulse_sequence VOC4CAT:0008121 coremeta4cat:drying VOC4CAT:0000024 VOC4CAT:0007218 coremeta4cat:sample_geometry coremeta4cat:image_resolution coremeta4cat:external_standard coremeta4cat:solver_type coremeta4cat:crystallisation_duration coremeta4cat:background_correction_method coremeta4cat:filter_type coremeta4cat:adsorbate_gas VOC4CAT:0000060 VOC4CAT:0008130 coremeta4cat:temperature_ramp coremeta4cat:milling_duration coremeta4cat:electrode_configuration VOC4CAT:0008155 coremeta4cat:filtration_device coremeta4cat:deposition_temperature coremeta4cat:field_emitter coremeta4cat:dispersant coremeta4cat:mixing_device coremeta4cat:internal_standard VOC4CAT:0008127 coremeta4cat:measurement_temperature coremeta4cat:force_field coremeta4cat:surface_coverage VOC4CAT:0000112 VOC4CAT:0000176 coremeta4cat:purification_solvent rdf:type coremeta4cat:crystallisation_solvents coremeta4cat:capillary_pressure VOC4CAT:0008113 coremeta4cat:noise_of_measurement CHMO:0002792 coremeta4cat:column_type coremeta4cat:flame_ring VOC4CAT:0000056 coremeta4cat:irradiation_frequency coremeta4cat:hasEnergyRange coremeta4cat:inlet_temperature VOC4CAT:0007203 coremeta4cat:sampling_interval coremeta4cat:nucleus coremeta4cat:calibration_standard coremeta4cat:set_temperature coremeta4cat:adsorption_gas coremeta4cat:pulse_time coremeta4cat:sample_spinning_speed NCIT:C204101 <http://purl.allotrope.org/ontologies/process#AFP_0003721> coremeta4cat:acceleration_voltage coremeta4cat:solvent_delay coremeta4cat:nmr_sample_tube coremeta4cat:reaction_vessel coremeta4cat:hasMzRange VOC4CAT:0007213 coremeta4cat:capillary_temperature coremeta4cat:hasTwoThetaRange coremeta4cat:diluting_reference core