coremeta4cat:MassRangeMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing mass-to-charge scan range slots shared by mass
spectrometry techniques (GCMS, ESI_MS).""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class qudt:Quantity ;
            sh:description """Mass-to-charge ratio scan range (minimum -> maximum m/z) as a QuantitativeRange.
