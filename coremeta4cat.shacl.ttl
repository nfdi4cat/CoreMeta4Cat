            sh:description "Device used for drying (e.g. oven, rotary evaporator)." ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path VOC4CAT:0008122 ],
        [ sh:datatype <xsd:anyURI> ;
