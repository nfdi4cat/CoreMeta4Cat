coremeta4cat:Surfaces a sh:NodeShape ;
    sh:closed true ;
    sh:description """Surface properties of a catalyst computed from a periodic slab model,
including surface energy, Miller index, slab thickness, and vacuum spacing.
Central to heterogeneous catalysis modelling.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Method used to terminate the slab and handle dangling bonds
(e.g. H-passivation, OH-termination, dipole correction).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:surface_termination_method ],
        [ sh:datatype <xsd:string> ;
            sh:description "Miller indices of the modelled surface facet (e.g. \"(111)\", \"(110)\", \"(100)\")." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:miller_indices ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ],
        [ sh:datatype <xsd:float> ;
            sh:description """Vacuum layer thickness added above the slab to prevent spurious
periodic interactions between slab images.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:vacuum_spacing ],
        [ sh:datatype <xsd:float> ;
            sh:description """Cleavage energy per unit area required to create the surface from the bulk.
A lower value indicates a more stable surface facet.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:surface_energy ],
        [ sh:datatype <xsd:float> ;
            sh:description "Thickness of the periodic slab model used to represent the surface." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:slab_thickness ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:value ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ] ;
    sh:targetClass coremeta4cat:Surfaces .

coremeta4cat:TemperatureProgramMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing temperature-programme parameters shared by thermal
analysis and temperature-programmed reaction techniques
(Thermogravimetry, TPO, TPR).""" ;
