coremeta4cat:ThermodynamicStability a sh:NodeShape ;
    sh:closed true ;
    sh:description """Thermodynamic stability of a material or phase, characterised by formation
energy, convex hull distance, and competing phases. Used to screen catalyst
stability and predict synthesis feasibility.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:float> ;
            sh:description """Distance above the convex hull of stable phases (thermodynamic stability
metric). Zero for phases on the hull; positive values indicate metastability.""" ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path coremeta4cat:energy_above_hull ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide the literal value of the QualitativeAttribute." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:value ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:description ],
        [ sh:datatype <xsd:string> ;
            sh:description "Type of phase diagram constructed (e.g. binary, ternary, quaternary)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path coremeta4cat:phase_diagram_type ],
        [ sh:datatype <xsd:string> ;
            sh:description """List of stable competing phases used in convex hull construction
(e.g. "Fe2O3, Fe3O4, FeO, Fe").""" ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path coremeta4cat:competing_phases ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Elemental reference energies used to compute formation energies
(e.g. DFT total energies of elemental ground-state structures).""" ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:reference_energies ],
        [ sh:datatype <xsd:float> ;
            sh:description "Formation energy per atom relative to elemental reference states." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:formation_energy ] ;
    sh:targetClass coremeta4cat:ThermodynamicStability .

coremeta4cat:XRaySourceMixin a sh:NodeShape ;
    sh:closed false ;
