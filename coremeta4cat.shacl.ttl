            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path dcterms:type ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Volume of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide data about the pressure of a MaterialEntity or an Activity, whereas the Pressure of an Activity is ontologically a quality borne by the material entities participating in the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path SIO:000008 ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify parts of a Device that are themselves Devices." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:hasPart ] ;
    sh:targetClass NCIT:C93052 .

OBI:0000070 a sh:NodeShape ;
    sh:closed true ;
    sh:description """A DataGeneratingActivity in which a catalyst is prepared.

The preparation protocol is linked via realized_plan using a
PreparationMethod instance. Input materials (Precursors) are linked via
had_input_entity. The resulting catalyst (CatalystSample) is linked via
had_output_entity.

The type of synthesis is further specified via rdf_type using an ontology
term (e.g. a VOC4CAT preparation method term), following DCAT-AP-PLUS
Pattern 3.""",
        """A DataGeneratingActivity in which a catalyst sample or catalytic material
is characterized using an analytical technique.

The catalyst sample being characterized is linked via evaluated_entity.
The analytical protocol is linked via realized_plan using a
CharacterizationTechnique instance. The instrument used is linked via
carried_out_by as a Device.

The specific technique type is expressed via rdf_type using an ontology
term (e.g. CHMO:0000158 for powder XRD, CHMO:0000404 for XPS),
following DCAT-AP-PLUS Pattern 3 — exactly as NMRSpectroscopy uses
rdf_type: CHMO:0000613.""" ;
    sh:ignoredProperties ( rdf:type ),
        ( rdf:type ) ;
    sh:property [ sh:class prov:Entity ;
            sh:description "The slot to relate a qualitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Agent ;
            sh:description """Equipment or synthesis device used to carry out this preparation step.
Provide a Device instance (e.g. rotary evaporator, autoclave, furnace).""" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity that was generated as an output of an Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path prov:generated ],
        [ sh:class OBI:0000272 ;
            sh:description "The CharacterizationTechnique (protocol) realized in this Characterization." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path rdf:type ],
        [ sh:class prov:Activity ;
            sh:description "The slot to specify the Activity about which the DataGeneratingActivity produced information." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasInformedBy ],
        [ sh:class adms:Identifier ;
            sh:description "The slot to provide a secondary identifier of the Activity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 14 ;
            sh:path adms:identifier ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to relate a quantitative attribute to an EvaluatedEntity, EvaluatedActivity or AgenticEntity" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 20 ;
            sh:path dcterms:relation ],
        [ sh:class prov:Activity ;
            sh:description "The slot to specify the Activity about which the DataGeneratingActivity produced information." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype <xsd:string> ;
            sh:description "Sample preparation steps applied immediately before measurement." ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path <http://purl.allotrope.org/ontologies/process#AFP_0001159> ],
        [ sh:datatype <xsd:string> ;
            sh:description "Support material on which the active phase is deposited (e.g. Al2O3, SiO2)." ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path VOC4CAT:0008104 ],
        [ sh:class prov:Entity ;
            sh:description "The catalyst sample or material being characterized." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:used ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity that is part of the Activity." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path dcterms:hasPart ],
        [ sh:class prov:Entity ;
            sh:description "The slot to specify the Entity about which the DataGeneratingActivity produced information." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:datatype <xsd:string> ;
            sh:description "Free-text description of the sample used in this characterization." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:sample_description ],
        [ sh:class VOC4CAT:0007016 ;
            sh:description "The PreparationMethod (protocol) realized in this Synthesis." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:used ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to provide a title for the Activity." ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:title ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "This slot is described in more detail within the class in which it is used." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dcterms:type ],
        [ sh:datatype <xsd:string> ;
            sh:description """Internal type designator for CatalysisDataGeneratingActivity subclasses
(Synthesis, Characterization, Simulation). Only needs to be set by hand
when nesting one of these inside another object's was_generated_by list
(e.g. in a combined CatalysisDataset file) -- LinkML fills it in
automatically when a class is instantiated directly.""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path rdf:type ],
        [ sh:class VOC4CAT:0000122 ;
            sh:description "Pre-treatment applied to the sample before a process or measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path SIO:000008 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description """The type of characterization technique as an ontology term, e.g.
CHMO:0000158 (powder XRD), CHMO:0000404 (XPS), VOC4CAT:0000075 (SEM).""" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path rdf:type ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide an Activity of which the Activity is a part." ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path dcterms:isPartOf ],
        [ sh:datatype <xsd:string> ;
            sh:description "Nominal elemental or chemical composition of the catalyst (e.g. 5wt% Pt/Al2O3)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:nominal_composition ],
        [ sh:class prov:Activity ;
            sh:description "The slot to provide a previous Activity that informed the Activity by being causally via a shared participant." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path prov:wasInformedBy ],
        [ sh:class VOC4CAT:0000122 ;
            sh:description "Pre-treatment applied to the sample before a process or measurement." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path SIO:000008 ],
        [ sh:class prov:Location ;
            sh:description "The slot to specify the Surrounding in which an Activity took place." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path prov:atLocation ],
        [ sh:datatype <xsd:string> ;
            sh:description "Conditions under which the catalyst is stored (e.g. inert atmosphere, 4°C)." ;
