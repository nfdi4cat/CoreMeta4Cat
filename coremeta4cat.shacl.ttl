            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 0 ;
            sh:path coremeta4cat:hasMzRange ] ;
    sh:targetClass coremeta4cat:MassRangeMixin .

coremeta4cat:MaterialDescriptorMixin a sh:NodeShape ;
    sh:closed false ;
    sh:description """Mixin providing material identity slots shared by CalculatedProperty
subclasses that target a specific material composition and crystal
structure (DielectricTensors, PhononDispersion, EquationsOfState,
