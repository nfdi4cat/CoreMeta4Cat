            sh:order 10 ;
            sh:path SIO:000008 ],
        [ sh:class qudt:Quantity ;
            sh:description "The slot to provide the Volume of a MaterialEntity." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 9 ;
            sh:path SIO:000008 ],
        [ sh:class prov:Agent ;
            sh:description "The slot to specify parts of a Device that are themselves Devices." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path dcterms:hasPart ],
        [ sh:datatype <xsd:anyURI> ;
            sh:description "A slot to provide an URI for an entity within this schema." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path <dcatap_plus:id> ],
        [ sh:description "The slot to specify the physical state of a MaterialEntity." ;
            sh:in ( <http://purl.obolibrary.org/obo/PATO_0001736> <http://purl.obolibrary.org/obo/PATO_0001735> <http://purl.obolibrary.org/obo/PATO_0001737> <http://purl.obolibrary.org/obo/PATO_0015012> ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path SIO:000008 ],
