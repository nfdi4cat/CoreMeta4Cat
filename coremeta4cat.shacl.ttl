            sh:description "A slot to provide a secondary identifier for a Device." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 15 ;
            sh:path adms:identifier ],
        [ sh:class qudt:Quantity ;
            sh:description """The volumetric flow rate at which gas is sparged/bubbled through the
liquid phase, or the rate of mechanical agitation used to maintain
the slurry suspension.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 2 ;
            sh:path coremeta4cat:agitation_sparging_rate ],
        [ sh:datatype <xsd:string> ;
            sh:description "The slot to specify an alternative label, name or title for a MaterialEntity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path skos:altLabel ] ;
    sh:targetClass coremeta4cat:SlurryReactor .

coremeta4cat:SonochemicalSynthesis a sh:NodeShape ;
    sh:closed true ;
    sh:description """Catalyst preparation using ultrasonic irradiation to drive chemical
reactions via acoustic cavitation.""" ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [ sh:datatype <xsd:integer> ;
            sh:description "Number of repeated cycles in a process (e.g. ALD cycles, impregnation cycles)." ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path VOC4CAT:0008123 ],
        [ sh:datatype <xsd:float> ;
            sh:description "Duration of ultrasonic irradiation." ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path coremeta4cat:sonication_duration ],
        [ sh:class coremeta4cat:Atmosphere ;
            sh:description "Atmosphere maintained during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path VOC4CAT:0008208 ],
        [ sh:class qudt:Quantity ;
            sh:description "Temperature applied during the drying step." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path VOC4CAT:0008207 ],
        [ sh:class qudt:Quantity ;
            sh:description "Duration of the drying step." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path VOC4CAT:0008206 ],
        [ sh:class qudt:Quantity ;
            sh:description "Gas flow rate maintained during calcination." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 12 ;
            sh:path VOC4CAT:0000056 ],
        [ sh:class schema1:DefinedTerm ;
            sh:description "The slot to specify the ontology class that is instantiated by an entity." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path rdf:type ],
        [ sh:datatype <xsd:float> ;
            sh:description "Acoustic power applied during sonication." ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path coremeta4cat:sonication_power ],
        [ sh:class qudt:Quantity ;
            sh:description """Temperature range of the calcination programme (initial -> final temperature),
provided as a QuantitativeRange. Unit: Degree Celsius.""" ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path coremeta4cat:hasCalcinationTemperatureRange ],
        [ sh:datatype <xsd:string> ;
