    sh:closed true ;
    sh:description "A word, name, acronym or phrase that is defined in a controlled vocabulary (CV) and that is used to provide an additional rdf:type or dcterms:type of a class within this schema." ;
    sh:ignoredProperties ( rdf:type ) ;
