coremeta4cat:SIM_6mxw-xsrd_DFT_active_sites dcterms:title "DFT binding energies of OH and CO at 17 oxide surface sites" ;
	a "Simulation" , voc4cat:0000215 ;
	prov:used coremeta4cat:SIM_6mxw-xsrd_DFT_method , coremeta4cat:SLAB_6mxw-xsrd_CuGa2O4_sites ;
	coremeta4cat:calculated_property _:c14n0 , _:c14n1 ;
	coremeta4cat:software_package "Atomic Simulation Environment (ASE), structure generation" , "VASP" , "pymatgen, structure generation" .
coremeta4cat:SIM_6mxw-xsrd_DFT_method dcterms:title "periodic DFT, PBE, PAW" ;
	a coremeta4cat:DFT ;
	coremeta4cat:exchange_correlation_functional "PBE" .
coremeta4cat:SLAB_6mxw-xsrd_CuGa2O4_sites dcterms:title "CuGa2O4 surface models, pristine and with 7 dopants" ;
	a prov:Entity .
voc4cat:0000215 schema1:name "density functional theory" ;
	a schema1:DefinedTerm .
_:c14n0 dcterms:description "CO binding energy; range over all sites (Ga2O3-Ru lowest, pristine Ga2O3 highest); referenced to gas-phase CO" ;
	a IAO:0000109 ;
	prov:value "-2.20 to 0.51 eV (17 sites)" .
_:c14n1 dcterms:description "OH binding energy; range over all sites (Ga2O3-Zn lowest, CuGa2O4-Cu highest); reference state not defined in the main text" ;
	a IAO:0000109 ;
	prov:value "-1.87 to 1.41 eV (17 sites)" .
