coremeta4cat:CAT_001_CuZnO_Al2O3 dcterms:description "63 wt% CuO, 24 wt% ZnO, 13 wt% Al2O3 (calcined precursor)" ;
	dcterms:title "Cu/ZnO/Al2O3 methanol synthesis catalyst" ;
	a prov:Entity .
coremeta4cat:CHAR_001_BET_CuZnO_Al2O3 a "Characterization" ;
