	prov:wasAssociatedWith coremeta4cat:DEV_003_Thermo_KAlpha_XPS , coremeta4cat:DEV_004_AlKalpha_source ;
	coremeta4cat:sample_description "NiO/CeO2 co-precipitated catalyst (SYNTH_002), calcined at 500 deg C, as-prepared (non-reduced), ca. 10 mg pressed into indium foil" ;
