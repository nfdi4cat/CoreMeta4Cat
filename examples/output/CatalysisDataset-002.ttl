	coremeta4cat:catalyst_measured_properties "BET surface area: 42 m2/g" , "Ni loading: 14.7 wt% (ICP-AES)" , "NiO crystallite size: 8.4 nm (Scherrer, XRD)" , "reducibility onset: 280 deg C, completion at 600 deg C (H2-TPR)" ;
	coremeta4cat:nominal_composition "15 wt% NiO/CeO2" ;
