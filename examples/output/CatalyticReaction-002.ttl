@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix SIO: <http://semanticscience.org/resource/SIO_> .
@prefix coremeta4cat: <https://w3id.org/nfdi4cat/coremeta4cat/> .
@prefix RXNO: <http://purl.obolibrary.org/obo/RXNO_> .
@prefix OBI: <http://purl.obolibrary.org/obo/OBI_> .
@prefix RO: <http://purl.obolibrary.org/obo/RO_> .
@prefix voc4cat: <https://w3id.org/nfdi4cat/voc4cat_> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
<https://pubchem.ncbi.nlm.nih.gov/compound/280> dcterms:title "CO2 (99.998% purity, Linde)" ;
	a SIO:010411 .
<https://pubchem.ncbi.nlm.nih.gov/compound/297> dcterms:title "CH4 (99.995% purity, Linde)" ;
	a SIO:010411 .
<https://pubchem.ncbi.nlm.nih.gov/compound/947> dcterms:title "N2 balance (99.999% purity, internal standard for GC quantification)" ;
	a SIO:010411 .
coremeta4cat:CAT_002_NiCeO2 dcterms:description "Ni0 after in situ reduction of NiO/CeO2" ;
	dcterms:title "Ni/CeO2" ;
	a SIO:010344 .
coremeta4cat:FEED_004_CH4_DRM dcterms:description "CH4 flow: 45 mL/min (STP); calibrated Brooks SLA5850 MFC" ;
	dcterms:title "methane feed (99.995%, Linde)" ;
	a prov:Entity .
coremeta4cat:FEED_005_CO2_DRM dcterms:description "CO2 flow: 45 mL/min (STP); calibrated Brooks SLA5850 MFC" ;
	dcterms:title "CO2 feed (99.998%, Linde)" ;
	a prov:Entity .
coremeta4cat:FEED_006_N2_standard dcterms:description "N2 flow: 10 mL/min (STP); used as internal standard for GC molar balance" ;
	dcterms:title "N2 internal standard (99.999%, Linde)" ;
	a prov:Entity .
coremeta4cat:REACT_003_FixedBed_DRM dcterms:description "quartz tube reactor, 8 mm inner diameter, 30 cm length; catalyst bed: 200 mg NiO/CeO2 (250-500 um sieve fraction) diluted 1:2 (mass) with inert SiC chips (500 um); thermocouple inserted into catalyst bed centre; backpressure regulator at outlet (1 bar); reactor surrounded by ceramic-fibre furnace with PID temperature controller; mass flow controllers (Brooks SLA5850) for CH4, CO2, N2" ;
	dcterms:title "quartz fixed-bed plug-flow reactor (DRM)" ;
	a voc4cat:0007018 .
coremeta4cat:REAC_002_DRM_NiCeO2 RO:0004009 <https://pubchem.ncbi.nlm.nih.gov/compound/280> , <https://pubchem.ncbi.nlm.nih.gov/compound/297> , <https://pubchem.ncbi.nlm.nih.gov/compound/947> ;
	RXNO:0000425 coremeta4cat:CAT_002_NiCeO2 ;
	SIO:000008 _:c14n0 ;
	a coremeta4cat:CatalyticReaction ;
	prov:used coremeta4cat:FEED_004_CH4_DRM , coremeta4cat:FEED_005_CO2_DRM , coremeta4cat:FEED_006_N2_standard ;
	prov:wasAssociatedWith coremeta4cat:REACT_003_FixedBed_DRM ;
	coremeta4cat:catalyst_form voc4cat:0007034 ;
	coremeta4cat:catalyst_quantity _:c14n3 ;
	coremeta4cat:feed_composition_range _:c14n1 , _:c14n5 ;
	coremeta4cat:product_identification_method coremeta4cat:REAC_002_GC_method ;
	voc4cat:0000118 _:c14n4 ;
	voc4cat:0007014 voc4cat:0007001 ;
	voc4cat:0007032 _:c14n6 ;
	voc4cat:0007809 _:c14n2 .
coremeta4cat:REAC_002_GC_method dcterms:description "Shimadzu GC-2014 with TCD detector (Ar carrier gas); column 1: HayeSep D (2 m x 1/8 in) for CO2, CH4 separation; column 2: Molecular Sieve 5A (2 m x 1/8 in) for CO, H2, N2, CH4 separation; 10-port Valco valve for column switching; oven temperature: 50 deg C isothermal; TCD temperature: 250 deg C; injection: automated gas sampling valve, 1 mL loop; analysis cycle: 10 min; calibration: certified gas standard (Air Liquide CRYSTAL mixture: H2 5%, CO 5%, CH4 5%, CO2 10%, N2 balance); CH4 conversion, CO2 conversion, H2/CO ratio, and carbon balance calculated from N2-normalised molar flows" ;
	dcterms:title "online dual-column gas chromatography (TCD)" ;
	a OBI:0000272 .
_:c14n0 qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Time> ;
	qudt:unit <https://qudt.org/vocab/unit/HR> ;
	a qudt:Quantity ;
	prov:value "20.0"^^xsd:float .
_:c14n1 dcterms:description "stoichiometric DRM: CH4/CO2 = 1:1 (molar)" ;
	a qudt:Quantity .
_:c14n2 a coremeta4cat:Atmosphere ;
	prov:value "CH4/CO2/N2 = 45:45:10 vol%, total flow 100 mL/min (STP), GHSV = 30000 mL/(g*h)" .
_:c14n3 qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Mass> ;
	qudt:unit <https://qudt.org/vocab/unit/GM> ;
	a qudt:Quantity ;
	prov:value "0.2"^^xsd:float .
_:c14n4 qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Pressure> ;
	qudt:unit <https://qudt.org/vocab/unit/ATM> ;
	a qudt:Quantity ;
	prov:value "1.0"^^xsd:float .
_:c14n5 dcterms:description "CO2-rich condition: CH4/CO2 = 1:1.5 to suppress carbon deposition" ;
	a qudt:Quantity .
_:c14n6 qudt:hasQuantityKind <http://qudt.org/vocab/quantitykind/Temperature> ;
	qudt:unit <https://qudt.org/vocab/unit/DEG_C> ;
	a qudt:Quantity ;
	coremeta4cat:maxValue "800.0"^^xsd:float ;
	coremeta4cat:minValue "600.0"^^xsd:float .
