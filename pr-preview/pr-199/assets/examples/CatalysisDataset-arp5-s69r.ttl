coremeta4cat:SYN_arp5-s69r_Pd3P_SiO2 dcterms:description "Pd(OAc)2 and H3PO4 dissolved in concentrated hydrochloric acid, impregnated onto silica, dried and treated in hydrogen at 400 C, following a previously reported procedure (article, section 2.2, ref. 44). The article gives the amounts for the 5 wt% Pd catalyst only." ;
	dcterms:title "Pd3P/SiO2 (5 wt% Pd) by incipient wetness impregnation and thermal treatment in hydrogen" ;
	a coremeta4cat:Synthesis ;
	adms:identifier _:c14n2 ;
	prov:generated coremeta4cat:CAT_arp5-s69r_Pd3P_SiO2_5wt ;
	prov:used coremeta4cat:PREC_arp5-s69r_H3PO4 , coremeta4cat:PREC_arp5-s69r_PdOAc2 , coremeta4cat:SUP_arp5-s69r_SiO2 , coremeta4cat:SYN_arp5-s69r_IWI_H2_method ;
	prov:wasAssociatedWith coremeta4cat:DEV_arp5-s69r_furnace ;
	coremeta4cat:catalyst_measured_properties "Mean particle size by HAADF-STEM: 5.6 nm" , "Pd loading by ICP-AES: 4.95 wt%" , "Pd3P phase confirmed by PXRD and HRTEM lattice fringes (article, section 3.1)" ;
	coremeta4cat:nominal_composition "Pd3P/SiO2: 5 wt% Pd" ;
	voc4cat:0007246 coremeta4cat:SOLV_arp5-s69r_HCl ;
	voc4cat:0008104 "silica, Cariact Q 20C (Fuji Silysia Chemical)" ;
	voc4cat:0008105 "Used directly or stored in an Ar-filled glovebox (MBraun) before use or analysis" .
coremeta4cat:SYN_arp5-s69r_Pd_SiO2 dcterms:description "Same procedure as SYN_arp5-s69r_Pd3P_SiO2, without H3PO4 (article, section 2.2)." ;
