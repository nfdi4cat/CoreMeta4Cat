	voc4cat:0007032 _:c14n16 ;
	voc4cat:0008141 _:c14n15 .
coremeta4cat:REAC_b74m-m6rp_reactor dcterms:description "0.8 cm inner diameter, 100 cm long, in a furnace; bed fixed by quartz wool, about 1.2 cm long; catalyst and silica sieve fraction 120-250 um; Bronkhorst mass flow controllers; two type N thermocouples about 2 mm up- and downstream of the bed." ;
	dcterms:title "quartz glass tubular packed-bed reactor" ;
	a coremeta4cat:FixedBedReactor ;
	coremeta4cat:catalyst_bed_diameter _:c14n10 ;
	voc4cat:0008217 _:c14n34 ;
	voc4cat:0008218 "silica particles, 700 mg, 120-250 um" .
coremeta4cat:SIM_b74m-m6rp_MKM_method dcterms:description "Modified Arrhenius rate expressions with coverage-dependent activation energies; catalytic area scaled by F_cat/geo from the metal dispersion. Parameter optimization in 5% steps with two dependent parameters fixed by thermodynamic consistency." ;
	dcterms:title "microkinetic packed-bed model, literature and optimized parameters" ;
	a coremeta4cat:Microkinetics .
coremeta4cat:SIM_b74m-m6rp_MKM_parametric dcterms:description "Simulations with the optimized microkinetic mechanism: axial NH3 and conversion profiles over the 12 mm bed at 618-818 K (article Fig. 8); spatially resolved surface coverages at 615 and 818 K (Fig. 9); turnover frequency of the Ru-only, Ni-only and combined models at 498-848 K, computed without reactor effects (Fig. 10); and variation of inlet NH3, GHSV (100-100,000 h-1) and pressure at 615 K or as a function of temperature (Fig. 11). Base case: 1000 ppm NH3 in Ar, 1 bar, GHSV 50,000 h-1, 615 K (= T10 of 0.5Ru/1Ba/Ni-BCZY)." ;
	dcterms:title "Microkinetic NH3 decomposition: reactor profiles, TOF and parameter variation" ;
	a "Simulation" ;
	adms:identifier _:c14n37 ;
	prov:used coremeta4cat:CAT_b74m-m6rp_0.5Ru-1Ba_Ni-BCZY , coremeta4cat:SIM_b74m-m6rp_MKM_parametric_method ;
	coremeta4cat:calculated_property _:c14n2 , _:c14n25 , _:c14n33 ;
	coremeta4cat:software_package "DETCHEM-PBR (DETCHEM package), reactor simulations" , "DETCHEM-SURFPROBE, surface coverages and TOF without reactor effects" .
coremeta4cat:SIM_b74m-m6rp_MKM_parametric_method dcterms:description "Mechanism with the optimized Ru and Ni parameters (article Table 4). Varied inputs: inlet NH3 mole fraction, GHSV, pressure, temperature." ;
	dcterms:title "optimized microkinetic packed-bed model, parameter variation" ;
	a coremeta4cat:Microkinetics .
coremeta4cat:SIM_b74m-m6rp_MKM_validation dcterms:description "One-dimensional packed-bed reactor simulation (negligible axial diffusion) with a mean-field surface mechanism on Ru and Ni sites, compared with the measured light-off curves at 500, 1000 and 3000 ppm NH3 in Ar, 1 bar, GHSV 50,000 h-1, ramp 2 K/min. Ni steps start from Zhu et al. (Int. J. Green Energy 19 (2022) 1568), Ru steps from Zhang et al. (ACS Sustain. Chem. Eng. 7 (2019) 18038, Ba-promoted Ru on YSZ, coverage-dependent activation energies). Both parameter sets were re-optimized against the 1000 ppm data and validated with the 500 and 3000 ppm data; the optimized set is article Table 4. Surface species: Ru, H-Ru, N-Ru, NH-Ru, NH2-Ru, NH3-Ru, Ni, H-Ni, N-Ni, NH-Ni, NH2-Ni, NH3-Ni." ;
	dcterms:title "Microkinetic simulation of NH3 decomposition light-off on Ni-BCZY and 0.5Ru/1Ba/Ni-BCZY" ;
	a "Simulation" ;
	adms:identifier _:c14n18 ;
