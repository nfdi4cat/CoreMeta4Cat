	voc4cat:0007246 coremeta4cat:SOLV_6mxw-xsrd_water .
coremeta4cat:SYN_6mxw-xsrd_coprecipitation_method dcterms:description "Metal nitrate solution fed at 1.6 mL/min into a glass reactor prefilled with 200 mL water, overhead stirrer at 500 rpm, ambient temperature; precipitant dosed to hold pH 9 +- 0.1. Suspension aged 2 h at 65 C at 500 rpm, cooled, filtered, washed to pH 7 +- 0.3, freeze-dried at -10 C and 3 mbar for 12 h to the HTC precursor. Calcination 4 h at 4 C/min in clean dry air; the library was calcined at 400, 500, 600, 700 and 900 C, the screening samples at 600 C. In-house computer-controlled precipitation plant." ;
	dcterms:title "automated co-precipitation at constant pH, ageing, freeze-drying, calcination" ;
	SIO:000008 _:c14n45 , _:c14n53 , _:c14n57 ;
	a voc4cat:0007795 ;
	coremeta4cat:hasCalcinationTemperatureRange _:c14n9 ;
	voc4cat:0000060 _:c14n6 ;
	voc4cat:0008116 _:c14n30 ;
	voc4cat:0008122 "freeze dryer (-10 C, 3 mbar)" ;
	voc4cat:0008125 _:c14n25 , _:c14n36 ;
	voc4cat:0008128 "metal nitrate solution pumped into prefilled water; precipitant added to keep pH 9" ;
	voc4cat:0008129 "suction filter" ;
	voc4cat:0008130 "washed with deionised water until pH 7 +- 0.3" ;
	voc4cat:0008131 _:c14n32 ;
