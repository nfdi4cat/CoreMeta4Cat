	dcterms:title "GC-MS product quantification" ;
	a OBI:0000272 .
coremeta4cat:REAC_arp5-s69r_Carbonylation_substrate dcterms:description "Iodobenzene in most runs; bromoiodobenzene (S3), iodotoluene (S4), and iodoanisole (S5) in the substrate-scope runs." ;
	dcterms:title "aryl iodide substrate" ;
